# Copy to .env only on your own computer for local testing. Never share these values.
CONNECTOR_SECRET=   # random string, 32+ characters (Render can generate it)
EBAY_APP_ID=        # "App ID (Client ID)" from developer.ebay.com > Application Keys (Production)
EBAY_CERT_ID=       # "Cert ID (Client Secret)" from the same page
EBAY_RUNAME=        # only needed for scripts/get-refresh-token.mjs
EBAY_REFRESH_TOKEN= # printed by scripts/get-refresh-token.mjs
EBAY_MARKETPLACE=EBAY_US
# Listings Claude may read but never change (your Baratza burr holders):
PROTECTED_ITEM_IDS=206531844850,206453290362,206595114694
PROTECTED_TITLE_KEYWORDS=Baratza,Burr Holder
